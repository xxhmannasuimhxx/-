# リザーブストック（リザスト）ログイン情報
# このファイルを mailmag/.env にコピーして書き換えてください（.env は git 管理外）
RESERVESTOCK_EMAIL=you@example.com
RESERVESTOCK_PASSWORD=********

# 画面URLを config/reservestock.json から変えたいときだけ設定
# RESERVESTOCK_LOGIN_URL=https://www.reservestock.jp/login
# RESERVESTOCK_COMPOSER_URL=https://www.reservestock.jp/mail_magazine/create

# 既定の配信リスト名（原稿の list: が優先）
# RESERVESTOCK_LIST=メルマガ読者

# 動作調整
# RESERVESTOCK_TIMEOUT=30000
# RESERVESTOCK_SLOWMO=200

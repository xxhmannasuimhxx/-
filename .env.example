# このファイルをコピーして .env を作り、実際の値を記入してください。
#   cp .env.example .env
# .env は .gitignore 済みなのでコミットされません。

# ── LINE Messaging API ──────────────────────────────────────────
# LINE Developers コンソール > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=

# LINE Developers コンソール > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# ── Claude API ──────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys で発行
# （`ant auth login` でログイン済みの場合は未設定でも動作します）
ANTHROPIC_API_KEY=

# 使用モデル（通常は変更不要）
ANTHROPIC_MODEL=claude-opus-5

# ── サーバー設定 ────────────────────────────────────────────────
PORT=3000

# 原稿の書き出し先ルート（未設定ならこのリポジトリ直下）
# CONTENT_ROOT=/path/to/madoka-content-system
